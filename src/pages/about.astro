---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About | Lillian Wray">
  <style>
    .about {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.85fr);
      gap: 76px;
      align-items: center;
    }

    .headshot {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      display: block;
    }

    .about-copy {
      max-width: 650px;
    }

    h1 {
      margin: 0 0 56px;
      color: var(--text);
      font-size: 1.7rem;
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1.2;
    }

    p {
      margin: 0 0 26px;
      color: #444;
      font-size: 1.08rem;
      font-weight: 400;
      line-height: 1.32;
    }

    .contact {
      margin-top: 64px;
    }

    .contact p {
      margin: 0;
    }

    .contact a {
      color: inherit;
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .about {
        grid-template-columns: 1fr;
        gap: 34px;
      }

      .headshot {
        width: min(100%, 320px);
        margin: 0 auto;
      }

      .about-copy {
        max-width: none;
      }

      h1 {
        margin-bottom: 32px;
        font-size: 1.35rem;
      }

      p {
        font-size: 1rem;
        line-height: 1.42;
      }

      .contact {
        margin-top: 40px;
      }
    }
  </style>

  <section class="about">
    <img class="headshot" src="/images/headshot.png" alt="Portrait of Lillian Wray" />

    <div class="about-copy">
      <h1>Hello, I'm Lilly!</h1>

      <p>
        I’m a third-year Industrial Design student at the University of
        Cincinnati with a strong interest in how products are made and how they
        actually work.
      </p>

      <p>
        I’ve always enjoyed problem-solving and thinking through systems, which
        is what drew me to industrial design. I like designs that balance
        creativity with logic, and I care a lot about function,
        manufacturability, and real-world use.
      </p>

      <p>
        After completing my first co-op at RIDGID Tools, I became especially
        interested in manufacturing-driven design and the relationship between
        design and engineering. I bring that mindset into my projects and enjoy
        learning through hands-on experience.
      </p>

      <p>
        I’m always excited to keep growing, exploring new ideas, and connecting
        with others. Feel free to reach out!
      </p>

      <div class="contact">
        <p><a href="mailto:wrayle@mail.uc.edu">wrayle@mail.uc.edu</a></p>
        <p><a href="tel:+14073885172">+1 (407) 388-5172</a></p>
      </div>
    </div>
  </section>
</MainLayout>
