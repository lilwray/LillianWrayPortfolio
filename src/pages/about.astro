---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About | Lillian Wray">
  <style>
    h1 {
      font-size: clamp(4rem, 8vw, 7rem);
      line-height: 0.9;
      letter-spacing: -0.055em;
      margin: 0 0 40px;
      font-weight: 600;
    }

    p {
      max-width: 800px;
      color: var(--muted);
      font-size: 1.15rem;
      line-height: 1.7;
      margin-bottom: 24px;
    }
  </style>

  <h1>About</h1>

  <p>
    I'm an Industrial Design student at the University of Cincinnati with a
    passion for creating thoughtful products, systems, and experiences.
  </p>

  <p>
    My work spans physical products, digital systems, prototyping,
    manufacturing, and human-centered design. I enjoy projects that sit at the
    intersection of design and engineering.
  </p>

  <p>
    Through internships and academic projects, I've worked on power tools,
    consumer products, UX systems, electronics, and future mobility concepts.
  </p>
</MainLayout>