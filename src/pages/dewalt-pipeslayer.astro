---
import MainLayout from "../layouts/MainLayout.astro";

const image = (number) => `/images/pipeslayer-images/Image${number}.png`;

const toolbox = [
  ["Image7", "One-Handed Reciprocating Saw"],
  ["Image8", "Impact Driver"],
  ["Image9", "MegaPress"],
];

const features = [
  {
    number: "1",
    title: "Flexible Shoe",
    text: "Adjusts to pipe angle and surface contour for cleaner cuts in tight or awkward spaces.",
  },
  {
    number: "2",
    title: "PTFE Vent Membranes",
    text: "Protects internal components from water and debris while allowing airflow to prevent overheating.",
  },
  {
    number: "3",
    title: "Lock",
    text: "Simple, one-handed latch makes blade changes quick and secure, even when the tool is wet.",
  },
  {
    number: "4",
    title: "Bumpers",
    text: "Shock absorbing overmold lessens impact damage and protects surrounding finishes in tight installs.",
  },
];
---

<MainLayout title="DEWALT PipeSlayer | Lillian Wray">
  <style>
    .case-study {
      --project-space: calc(var(--page-space) * 1.5);
      --content-gap: calc(var(--project-space) * 0.5);
      --image-radius: 8px;
      --title-size: clamp(2rem, 3.25vw, 3rem);
      --subtitle-size: clamp(1.1rem, 1.45vw, 1.42rem);
      --heading-size: 1.35rem;
      --body-size: 0.88rem;
      --caption-size: 0.78rem;
      margin: calc(var(--page-space) * -1);
      font-size: 1rem;
      line-height: 1.45;
    }

    .project-hero-image {
      display: block;
      width: 100%;
      height: calc(100vh - 96px);
      min-height: 560px;
      object-fit: cover;
      border-radius: 0;
    }

    .case-content {
      padding: var(--project-space);
    }

    .case-study figure {
      margin: 0;
    }

    .case-hero,
    .project-section,
    .image-row,
    .feature-layout,
    .gallery-grid {
      margin-bottom: var(--project-space);
    }

    .case-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) 1px minmax(260px, 0.65fr);
      gap: var(--content-gap);
      align-items: center;
    }

    .intro-copy h1 {
      margin: 0;
      font-size: var(--title-size);
      line-height: 0.98;
      font-weight: 700;
      letter-spacing: -0.035em;
      text-transform: uppercase;
    }

    .intro-copy .subtitle {
      margin: 6px 0 var(--content-gap);
      font-size: var(--subtitle-size);
      font-weight: 400;
      line-height: 1.2;
    }

    .intro-copy p,
    .detail-list,
    .body-copy {
      color: #414141;
      font-size: var(--body-size);
      font-weight: 300;
      line-height: 1.52;
    }

    .intro-copy p {
      max-width: 680px;
      margin: 0;
    }

    .hero-rule {
      width: 1px;
      height: 170px;
      background: #282828;
    }

    .detail-list {
      margin: 0;
    }

    .detail-list p {
      margin: 0 0 26px;
    }

    .detail-list p:last-child {
      margin-bottom: 0;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: var(--project-space);
      color: #6e6e6e;
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .section-label::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #282828;
    }

    .statement {
      margin: 0 auto var(--project-space);
      text-align: center;
      font-size: clamp(1.45rem, 2.4vw, 2.35rem);
      font-weight: 400;
      line-height: 1.22;
      letter-spacing: -0.02em;
    }

    .statement strong {
      font-weight: 800;
    }

    .brand-statement {
      margin-top: var(--project-space);
    }

    .media {
      display: block;
      width: 100%;
      border-radius: var(--image-radius);
    }

    .caption {
      margin: 10px 0 0;
      color: #3d3d3d;
      font-size: var(--caption-size);
      font-weight: 300;
    }

    .caption.right {
      text-align: right;
    }

    .text-block {
      margin-top: var(--content-gap);
    }

    .text-block h2,
    .subhead {
      margin: 0 0 22px;
      font-size: var(--heading-size);
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: -0.015em;
    }

    .body-copy {
      margin: 0;
    }

    .question {
      margin-top: var(--project-space);
      text-align: center;
    }

    .question p {
      margin: 0 0 16px;
      font-size: 1.55rem;
      font-style: italic;
      font-weight: 400;
    }

    .question strong {
      font-size: 2.25rem;
      font-weight: 700;
    }

    .image-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--content-gap);
      align-items: start;
    }

    .image-row.strains {
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
    }

    .matched-media {
      height: 520px;
      object-fit: cover;
    }

    .method-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--content-gap);
    }

    .toolbox-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr)) 1fr;
      gap: var(--content-gap);
      align-items: center;
      margin-bottom: var(--project-space);
    }

    .toolbox-notes {
      color: #282828;
      font-size: 1.02rem;
      font-weight: 400;
      line-height: 1.45;
    }

    .design-grid {
      display: grid;
      grid-template-columns: 2fr 0.82fr;
      gap: var(--content-gap);
      align-items: start;
      margin-bottom: var(--project-space);
    }

    .design-grid .media {
      height: 760px;
      object-fit: cover;
    }

    .stack {
      display: grid;
      gap: var(--content-gap);
    }

    .design-grid .stack {
      grid-template-rows: repeat(2, 1fr);
      height: 760px;
    }

    .design-grid .stack .media {
      height: 100%;
    }

    .final-intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--content-gap);
      align-items: start;
      margin-bottom: var(--project-space);
    }

    .feature-layout {
      display: grid;
      grid-template-columns: 1.25fr 0.95fr;
      gap: var(--content-gap);
      align-items: center;
    }

    .feature-list {
      display: grid;
      gap: 24px;
    }

    .feature {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 18px;
    }

    .feature-number {
      display: inline-flex;
      width: 24px;
      height: 24px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #000;
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1;
    }

    .feature h3 {
      margin: 0 0 6px;
      font-size: 1rem;
      font-weight: 600;
    }

    .feature p {
      margin: 0;
      color: #414141;
      font-size: 0.76rem;
      font-weight: 300;
      line-height: 1.45;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.65fr;
      gap: var(--content-gap);
      align-items: stretch;
    }

    .gallery-grid .media {
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .gallery-grid .stack {
      grid-template-rows: repeat(2, 1fr);
      height: 100%;
    }

    .gallery-grid .stack .media {
      height: 100%;
      min-height: 0;
    }

    .gallery-grid.reversed {
      grid-template-columns: 0.6fr 1.4fr;
    }

    .project-pager {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0;
      font-size: 1.1rem;
      font-weight: 400;
    }

    .project-pager a {
      transition:
        transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 360ms ease-in-out;
    }

    .project-pager a:hover {
      opacity: 0.65;
      transform: translateY(1px);
    }

    @media (max-width: 900px) {
      .case-study {
        --project-space: var(--page-space);
        --content-gap: var(--page-space);
        --title-size: 2.25rem;
        --subtitle-size: 1.35rem;
        --heading-size: 1.25rem;
        --body-size: 0.96rem;
        --caption-size: 0.76rem;
      }

      .project-hero-image {
        height: 230px;
        min-height: 0;
      }

      .case-content {
        padding: var(--page-space);
      }

      .case-hero,
      .image-row,
      .image-row.strains,
      .method-grid,
      .toolbox-grid,
      .design-grid,
      .final-intro,
      .feature-layout,
      .gallery-grid,
      .gallery-grid.reversed {
        grid-template-columns: 1fr;
        gap: var(--page-space);
      }

      .matched-media,
      .design-grid .media,
      .design-grid .stack,
      .design-grid .stack .media,
      .gallery-grid .media,
      .gallery-grid .stack,
      .gallery-grid .stack .media {
        height: auto;
      }

      .hero-rule {
        width: 100%;
        height: 1px;
      }

      .intro-copy .subtitle {
        margin-bottom: 28px;
      }

      .section-label {
        margin-bottom: var(--page-space);
        font-size: 0.82rem;
      }

      .statement {
        text-align: left;
      }

      .caption.right {
        text-align: left;
      }

      .toolbox-grid {
        align-items: start;
      }

      .feature-layout {
        align-items: start;
      }

      .project-pager {
        font-size: 1rem;
      }
    }
  </style>

  <article class="case-study">
    <img
      class="project-hero-image"
      src="/images/pipeslayer-images/pipeslayer-hero.png"
      alt="PipeSlayer hero placeholder"
    />

    <div class="case-content">
      <section class="case-hero">
        <div class="intro-copy">
          <h1>DEWALT PipeSlayer</h1>
          <p class="subtitle">One-Handed Reciprocating Saw</p>
          <p>
            The DEWALT PipeSlayer tackles one of plumbing's most frustrating
            challenges: cutting pipe in hard to reach areas. Compact, balanced,
            and purpose built, the PipeSlayer gives plumbers the control and
            power they need without the bulk of traditional saws.
          </p>
        </div>

        <div class="hero-rule" aria-hidden="true"></div>

        <div class="detail-list">
          <p>
            12 Week Studio Project<br />
            University of Cincinnati<br />
            Professors John Dixon and Mike Rowe
          </p>
          <p>Skills: Fusion360, Digital Rendering, Foam Prototyping</p>
        </div>
      </section>

      <section class="project-section">
        <div class="section-label">01. Research</div>

      <p class="statement">No two jobsites are the same.</p>

      <figure>
        <img class="media" src={image(1)} alt="Image1 placeholder" />
        <figcaption class="caption right">
          Linda, CMPA plumber and board member
        </figcaption>
      </figure>

      <div class="text-block">
        <h2>The Life of a Plumber</h2>
        <p class="body-copy">
          Plumbers work in some of the toughest environments: tight crawl
          spaces, flooded basements, and behind fragile finishes. Their tools
          must be as durable and adaptable as they are. <strong>Limited truck
          space, constant water exposure, and unpredictable conditions</strong>
          make compact, reliable tools a necessity. Linda has been in the trade
          for over 20 years. She emphasized how her tools take a beating, from
          corrosion to repeated drops, and how reliability often matters more
          than comfort or brand.
        </p>
      </div>

      <div class="question">
        <p>What is your most frequent task?</p>
        <strong>Cuttin' pipe.</strong>
      </div>
      </section>

      <section class="project-section">
      <h2 class="subhead">Strains on the Job</h2>

      <div class="image-row strains">
        <img class="media matched-media" src={image(2)} alt="Image2 placeholder" />
        <img class="media matched-media" src={image(3)} alt="Image3 placeholder" />
      </div>

      <p class="statement">
        Why is cutting pipe <em>still</em> such a challenge?
      </p>

      <h2 class="subhead">Standard Pipe Cutting Methods</h2>
      <div class="method-grid">
        <figure>
          <img class="media" src={image(4)} alt="Image4 placeholder" />
          <figcaption class="caption">Reciprocating Saw</figcaption>
        </figure>
        <figure>
          <img class="media" src={image(5)} alt="Image5 placeholder" />
          <figcaption class="caption">Chain Snap</figcaption>
        </figure>
      </div>
      </section>

      <section class="project-section">
      <img class="media" src={image(6)} alt="Image6 placeholder" />

      <p class="statement brand-statement">
        A saw made for plumbers needs a brand that is
        <strong>GUARANTEED TOUGH.</strong>
      </p>

      <h2 class="subhead">Current DEWALT Toolbox</h2>
      <div class="toolbox-grid">
        {
          toolbox.map(([fileName, caption]) => (
            <figure>
              <img
                class="media"
                src={`/images/pipeslayer-images/${fileName}.png`}
                alt={`${fileName} placeholder`}
              />
              <figcaption class="caption">{caption}</figcaption>
            </figure>
          ))
        }

        <div class="toolbox-notes">
          Component-Dominant<br />
          Color Defined Grip<br />
          Aluminum Front Housing<br />
          Logo Placement<br />
          Trigger + Lock<br />
          Battery Transition
        </div>
      </div>

      <h2 class="subhead">Design Exploration</h2>
      <div class="design-grid">
        <figure>
          <img class="media" src={image(10)} alt="Image10 placeholder" />
          <figcaption class="caption">
            Going back and forth between CAD and sketching allowed me to dive
            deeply into DEWALT's brand language and make quick direction
            changes.
          </figcaption>
        </figure>

        <div class="stack">
          <img class="media" src={image(11)} alt="Image11 placeholder" />
          <img class="media" src={image(12)} alt="Image12 placeholder" />
        </div>
      </div>
      </section>

      <section class="project-section">
      <div class="section-label">02. Final Design</div>

      <div class="final-intro">
        <div>
          <h2 class="subhead">PipeSlayer</h2>
          <p class="body-copy">A pipe cutting saw made for plumbers.</p>
        </div>

        <img class="media" src={image(13)} alt="Image13 placeholder" />
      </div>

      <div class="feature-layout">
        <img class="media" src={image(14)} alt="Image14 placeholder" />

        <div class="feature-list">
          {
            features.map((feature) => (
              <div class="feature">
                <span class="feature-number">{feature.number}</span>
                <div>
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="gallery-grid">
        <img class="media" src={image(15)} alt="Image15 placeholder" />
        <div class="stack">
          <img class="media" src={image(16)} alt="Image16 placeholder" />
          <img class="media" src={image(17)} alt="Image17 placeholder" />
        </div>
      </div>

      <div class="gallery-grid reversed">
        <div class="stack">
          <img class="media" src={image(18)} alt="Image18 placeholder" />
          <img class="media" src={image(19)} alt="Image19 placeholder" />
        </div>
        <img class="media" src={image(20)} alt="Image20 placeholder" />
      </div>

      <img class="media" src={image(21)} alt="Image21 placeholder" />
      </section>

      <nav class="project-pager" aria-label="Project pagination">
        <a href="/zumi">‹ Zumi</a>
        <a href="/vielle">Vielle ›</a>
      </nav>
    </div>
  </article>
</MainLayout>
