---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "PipeSlayer",
    image: "/images/pipeslayer.jpeg",
    href: "/dewalt-pipeslayer",
  },
  {
    title: "Vielle",
    image: "/images/vielle.png",
    href: "/vielle",
  },
  {
    title: "Zumi",
    image: "/images/zumi.png",
    href: "/zumi",
  },
];
---

<MainLayout title="Lillian Wray">
  <style>
    .projects {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      padding-bottom: 80px;
    }

    .project {
      color: inherit;
      text-decoration: none;
    }

    .project-image {
      width: 100%;
      height: 280px;
      overflow: hidden;
      border-radius: 16px;
      background: #d8d8d8;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .project h2 {
      margin: 14px 0 0;
      font-size: 1.8rem;
      font-weight: 600;
      letter-spacing: -0.035em;
    }

    @media (max-width: 900px) {
      .projects {
        grid-template-columns: 1fr;
      }

      .project-image {
        height: 240px;
      }
    }
  </style>

  <section class="projects">
    {
      projects.map((project) => (
        <a class="project" href={project.href}>
          <div class="project-image">
            <img src={project.image} alt={project.title} />
          </div>

          <h2>{project.title}</h2>
        </a>
      ))
    }
  </section>
</MainLayout>
