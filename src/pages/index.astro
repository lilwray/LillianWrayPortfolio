---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "PipeSlayer",
    image: "/images/pipeslayer.jpeg",
    href: "/dewalt-pipeslayer",
  },
  {
    title: "Vielle",
    image: "/images/vielle.png",
    href: "/vielle",
  },
  {
    title: "Zumi",
    image: "/images/zumi.png",
    href: "/zumi",
  },
];
---

<MainLayout title="Lillian Wray">
  <style>
    .projects {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      padding-bottom: 80px;
    }

    .project {
      color: inherit;
      text-decoration: none;
    }

    .project-image {
      position: relative;
      width: 100%;
      height: 280px;
      overflow: hidden;
      border-radius: 8px;
      background: #d8d8d8;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .project h2 {
      position: absolute;
      left: 18px;
      bottom: 16px;
      margin: 0;
      color: #282828;
      font-family: "proxima-nova", Arial, sans-serif;
      font-size: 1.02rem;
      font-weight: 400;
      letter-spacing: 0;
      opacity: 0;
      transform: translateY(1px);
      transition:
        transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 360ms ease-in-out;
      z-index: 1;
    }

    .project:hover h2,
    .project:focus-visible h2 {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 900px) {
      .projects {
        grid-template-columns: 1fr;
      }

      .project-image {
        height: 240px;
      }
    }
  </style>

  <section class="projects">
    {
      projects.map((project) => (
        <a class="project" href={project.href}>
          <div class="project-image">
            <img src={project.image} alt={project.title} />
            <h2>{project.title}</h2>
          </div>
        </a>
      ))
    }
  </section>
</MainLayout>
