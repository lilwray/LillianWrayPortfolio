---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "PipeSlayer",
    slug: "pipeslayer",
    image: "/images/pipeslayer2.png",
    href: "/dewalt-pipeslayer",
  },
  {
    title: "Vielle",
    slug: "vielle",
    image: "/images/vielle2.png",
    href: "/vielle",
  },
  {
    title: "Zumi",
    slug: "zumi",
    image: "/images/zumi2.png",
    href: "/zumi",
  },
];
---

<MainLayout title="Lillian Wray">
  <style>
    .projects {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 50px;
      padding-bottom: 80px;
    }

    .project {
      position: relative;
      display: block;
      color: inherit;
      text-decoration: none;
    }

    .project:first-child {
      grid-column: 1 / -1;
    }

    .project-image {
      position: relative;
      width: 100%;
      height: 520px;
      overflow: hidden;
      border-radius: 8px;
      background: #d8d8d8;
    }

    .project:first-child .project-image {
      height: 560px;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform: scale(1);
      transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project h2 {
      position: absolute;
      left: 28px;
      bottom: 28px;
      margin: 0;
      color: #282828;
      font-family: "proxima-nova", Arial, sans-serif;
      font-size: 2.9rem;
      font-weight: 600;
      letter-spacing: 0;
      opacity: 0;
      transform: translateY(6px);
      transition:
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 180ms ease-in-out;
      z-index: 1;
    }

    .project:hover h2,
    .project:focus-visible h2 {
      opacity: 1;
      transform: translateY(0);
      transition:
        transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 700ms ease-in-out;
    }

    .project:hover img,
    .project:focus-visible img {
      transform: scale(1.08);
    }

    @media (max-width: 900px) {
      .projects {
        grid-template-columns: 1fr;
        gap: 28px;
        padding-bottom: 28px;
      }

      .project:first-child {
        grid-column: auto;
      }

      .project:first-child .project-image,
      .project-image {
        height: 240px;
      }

      .project-image img,
      .project:hover img,
      .project:focus-visible img {
        transform: none;
      }

      .project h2 {
        position: static;
        margin: 12px 0 0;
        font-size: 1rem;
        font-weight: 400;
        color: #282828;
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <section class="projects">
    {
      projects.map((project) => (
        <a class={`project project-${project.slug}`} href={project.href}>
          <div class="project-image">
            <img src={project.image} alt={project.title} />
          </div>
          <h2>{project.title}</h2>
        </a>
      ))
    }
  </section>
</MainLayout>
