---
const { title = "Lillian Wray" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://use.typekit.net/amj6mec.css" />
  </head>

  <style>
    :root {
      --bg: #ebedef;
      --text: #282828;
      --muted: #5f5f5f;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "proxima-nova", Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .site-header {
      width: 100%;
      background: var(--bg);
      border-bottom: 0.5px solid #000;
    }

    .site-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 96px;
      padding: 0 40px;
      color: #282828;
      font-size: 1.02rem;
      font-weight: 400;
    }

    .brand {
      font-size: 1.34rem;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 39px;
    }

    .nav-links a {
      display: inline-block;
      transition:
        transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 360ms ease-in-out;
    }

    .nav-links a:hover {
      opacity: 0.6;
      transform: translateY(1px);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 68px 40px 40px;
    }

    @media (max-width: 700px) {
      .site-nav {
        min-height: 72px;
        padding: 0 21px;
        font-size: 0.75rem;
      }

      .brand {
        font-size: 0.81rem;
        letter-spacing: 0.14em;
      }

      .nav-links {
        gap: 15px;
      }

      .container {
        padding: 52px 28px 28px;
      }
    }
  </style>

  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href="/">Lillian Wray</a>

        <div class="nav-links">
          <a href="/">Work</a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
            Resume
          </a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <div class="container">
      <slot />
    </div>
  </body>
</html>
